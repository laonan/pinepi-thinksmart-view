# Copy to /etc/pinepi-hub/runtime.env; adjust user path and active LAN interface.
# Credentials remain in the private JSON file; never place them in this file.
PINEPI_HUB_ARGS="--host 0.0.0.0 --discover --discovery-interface eth0 --link-test-config /home/alan/.config/pinepi-hub/link-test.json"

# Optional outbound cloud subscriber (requires text-notification-capable terminal >=0.7.2):
# Append to PINEPI_HUB_ARGS:
# --broadcast-mid-config /home/alan/.config/pinepi-hub/broadcast-mid.json --notification-state /var/lib/pinepi-hub/notifications.json
